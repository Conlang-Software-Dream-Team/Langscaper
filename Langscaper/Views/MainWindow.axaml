<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CSP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CSP.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Langscaper.png"
        Title="Langscaper">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <DockPanel>
    <!-- Menu en haut -->
    <Menu Background="AliceBlue" DockPanel.Dock="Top">
      <MenuItem Header="{Binding ConlangName}" Command="{Binding GoToHomePage}" />
      <MenuItem Header="_File">
        <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="_Save as" Command="{Binding SaveAsProjectCommand}"/>
        <Separator/>
        <MenuItem Header="_New language" />
        <Separator/>
        <MenuItem Header="_Open" />
        <MenuItem Header="_Open recent" />
        <Separator/>
        <MenuItem Header="_Language settings..." Command="{Binding OpenSettings}" />
        <Separator/>
        <MenuItem Header="_Exit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" />
        <MenuItem Header="Redo" />
      </MenuItem>
    </Menu>

    <TextBlock DockPanel.Dock="Bottom"
               Background="BurlyWood"
               Text="{Binding LogMessage}"
               FontSize="14"
               VerticalAlignment="Center"
               Padding="5" />

    <SplitView IsPaneOpen="{Binding IsSidePanelOpen}"
               OpenPaneLength="180"
               CompactPaneLength="32"
               PaneBackground="AliceBlue"
               PanePlacement="Left"
               DisplayMode="CompactInline">
      <SplitView.Pane>
        <StackPanel>
          <Button Command="{Binding ToggleSidePanel}" HorizontalAlignment="Right">
            <PathIcon Data="{StaticResource line_horizontal_3_regular}" />
          </Button>
          <ListBox ItemsSource="{Binding ButtonIconList}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:ButtonIconTemplate">
                <StackPanel Orientation="Horizontal">
                  <PathIcon Margin="-5" Data="{Binding Icon}" />
                  <TextBlock Margin="15,0,0,0" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </SplitView.Pane>
      <SplitView.Content>
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
          <Border Background="Beige">
            <TransitioningContentControl Content="{Binding CurrentPage}" />
          </Border>
        </ScrollViewer>
      </SplitView.Content>
    </SplitView>
  </DockPanel>
</Window>
