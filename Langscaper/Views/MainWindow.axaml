<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CSP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CSP.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Langscaper.png"
        Title="Langscaper">

  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainWindowViewModel/>
  </Design.DataContext>


  <DockPanel>
    <Menu Background="AliceBlue" DockPanel.Dock="Top">
      <MenuItem Header="{Binding ConlangName}" />
      <MenuItem Header="_File">
        <MenuItem Header="_Save" InputGesture="ctrl+s"/>
        <MenuItem Header="_Save as" InputGesture="ctrl+shift+s"/>
        <Separator/>
        <MenuItem Header="_New language"/>
        <Separator/>
        <MenuItem Header="_Open"/>
        <MenuItem Header="_Open recent"/>
        <Separator/>
        <MenuItem Header="_Exit" InputGesture="ctrl+q"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" InputGesture="ctrl+z"/>
        <MenuItem Header="Redo" InputGesture="ctrl+shift+z"/>
      </MenuItem>
    </Menu>
    <TextBlock/>


    <SplitView IsPaneOpen="{Binding IsSidePanelOpen}"
               OpenPaneLength="180"
               CompactPaneLength="32"
               PaneBackground="AliceBlue"
               PanePlacement="Left"
               DisplayMode="CompactInline"
                      >
      <SplitView.Pane>
        <StackPanel>
          <Button Command="{Binding ToggleSidePanel}" HorizontalAlignment="Right">
            <PathIcon Data="{StaticResource line_horizontal_3_regular}"/>
          </Button>
          <ListBox ItemsSource="{Binding ButtonIconList}" SelectedItem="{Binding SelectedSection}">

            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:ButtonIconTemplate}">
                <StackPanel Orientation="Horizontal">
                  <PathIcon Margin="-5" Data="{Binding Icon}"/>
                  <TextBlock Margin="15,0,0,0" Text="{Binding Label}"></TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>


          </ListBox>
        </StackPanel>
      </SplitView.Pane>

      <SplitView.Content>
        <Border Background="Beige">
          <TransitioningContentControl Content="{Binding CurrentPage}">

          </TransitioningContentControl>
        </Border>
      </SplitView.Content>

    </SplitView>


  </DockPanel>







</Window>
